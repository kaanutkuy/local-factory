# Factory config. Shell-sourced by loop.sh. Keep it boring.

# Command the judge runs to exercise the real program. Language-agnostic.
# Stdout/stderr are captured and shown to the judge. Non-zero exit is fine —
# the judge interprets behavior, not pass/fail.
# Leave empty if a task is purely static (the judge will rely on file reads alone).
VALIDATE_CMD='set +e; echo "===== slugify ====="; for s in "Hello World" "Foo Bar Baz" "foo_bar baz" "Café Résumé" "Hello,  World!"; do echo "--- input: [$s] ---"; out=$(python3 slugify.py "$s" 2>&1); rc=$?; echo "output: [$out]"; echo "exit=$rc"; done; echo "===== greet (regression-check only) ====="; echo "--- basic ---"; python3 greet.py --name World 2>&1; echo "exit=$?"; echo "--- multi ---"; python3 greet.py --name "Ada Lovelace" 2>&1; echo "exit=$?"; echo "--- missing ---"; python3 greet.py 2>&1; echo "exit=$?"; echo "--- help ---"; python3 greet.py --help 2>&1; echo "exit=$?"'

# Maximum builder→judge iterations before the loop gives up.
MAX_ITERS=8

# Judge score (0.0..1.0) at which we call the holdout satisfied.
THRESHOLD=0.9

# Where the loop lives, relative to repo root. Don't change unless you move things.
FACTORY_DIR="factory"
